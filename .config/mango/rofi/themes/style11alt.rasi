
/*****----- Configuration -----*****/
configuration {
	modi:                       "drun,filebrowser,run,recursivebrowser";
    show-icons:                 true;
}

// @import "~/.config/wallust/rofi.rasi"
@theme "~/.config/mango/rofi/colors.rasi"
/*****----- Global Properties -----*****/
* {
    // background-color : @background;
    foreground-colour: @color7;
    outline-variant: @color13;
    outline: @color9;
    on-surface-variant: @color7;
    on-surface: @color15;
    primary-container: @color9;
    on-primary: @color9;
    border-colour: @color15;
    element-bg:@color9;
    surface-container: @color13;
    outline: @color9;
    primary: @color7;
    on-primary-container: @color7;
  }

/*****----- Main Window -----*****/
window {
    location:       west;
    anchor:         west;
    fullscreen:     false;
    width:          360px;      // un poco más estrecho
    height:         90%;        // casi toda la altura
    y-offset:       5%;         // centrado verticalmente
    margin:         0px 0px 0px 8px;
    border-radius:  18px;
    padding:        4px;
}
/*****----- Main Box -----*****/
//     children:                    [ "inputbar", "message", "listview", "mode-switcher" ];
// }
mainbox {
    padding:        8px;        // menos padding
    spacing:        6px;
}
/*****----- Inputbar -----*****/
inputbar {
    margin:         0px 0px 6px 0px;
    padding:        10px;
    background-color:            @color4;
}
prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    margin: 			 0 4px;
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "::";
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Type to search";
    opacity:                     0.3;
}
num-filtered-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
textbox-num-sep {
    enabled:                     true;
    expand:                      false;
    str:                         "/";
    background-color:            inherit;
    text-color:                  inherit;
}
num-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
case-indicator {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}

/*****----- Listview -----*****/
listview {
    lines:          12;         // más filas visibles
    fixed-height:   false;      // deja que crezca con el contenido
    padding:        0px 0px;
    spacing:        4px;
    background-color:            transparent;
}
scrollbar {
    handle-width:                5px ;
    border-radius:               5px;
}

/*****----- Elements -----*****/
element {
    margin:         1px 0px;
    background-color:            transparent;
}
element.selected {
    background:                  @color4;
    background-color:            @color4;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    // size:                        12px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    border:                      1px solid;
    border-radius:               8px;
}
textbox {
    // padding:                     px;
    border:                      0px solid;
    border-radius:               4px;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px;
}

